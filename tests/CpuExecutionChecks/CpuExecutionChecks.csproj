<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>ProductionSearchHost</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);RT2_PREFIX_HASH_CPU_ONLY</DefineConstants>
    <Rt2AssemblyDirectory Condition="'$(Rt2AssemblyPath)' != '' and '$(Rt2AssemblyDirectory)' == ''">$([System.IO.Path]::GetDirectoryName('$(Rt2AssemblyPath)'))</Rt2AssemblyDirectory>
  </PropertyGroup>
  <Import Project="../../Sts2PathDiscovery.props" />
  <ItemGroup Condition="'$(Rt2AssemblyPath)' == ''">
    <ProjectReference Include="../../RolltheSpire2.csproj" AdditionalProperties="Rt2ModsDir=" />
  </ItemGroup>
  <ItemGroup Condition="'$(Rt2AssemblyPath)' != ''">
    <Reference Include="RolltheSpire2"><HintPath>$(Rt2AssemblyPath)</HintPath><Private>true</Private></Reference>
    <Reference Include="GodotSharp" Condition="Exists('$(Rt2AssemblyDirectory)/GodotSharp.dll')">
      <HintPath>$(Rt2AssemblyDirectory)/GodotSharp.dll</HintPath><Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../GpuResourceSmoke/PrefixHashChecks.cs" Link="PrefixHashCpuChecks.cs" />
    <Reference Include="sts2"><HintPath>$(Sts2ReferenceDir)/sts2.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(Sts2ReferenceDir)/0Harmony.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
</Project>
